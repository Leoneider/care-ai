# Copia este archivo a .env y rellena las claves.
# El .env real no se versiona: lleva credenciales del buzon y del modelo.

# --- Modelo -----------------------------------------------------------------
# Formato de init_chat_model: "proveedor:modelo"
CARE_MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Modo offline: respuestas simuladas, no llama al modelo. Util para probar la UI
# y el flujo completo sin gastar tokens.
CARE_FAKE_LLM=0

# --- Trazas (opcional) ------------------------------------------------------
# Sin LANGSMITH_API_KEY el tracing se apaga solo y te lo dice.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=care-ai

# --- Persistencia -----------------------------------------------------------
# Bandeja de casos + checkpoints del grafo, en el mismo archivo.
CARE_DB=data/care.db
# CARE_CHECKPOINT=memory   # vuelve al saver en RAM: pierde los casos al salir
# Dataset de revisiones. Relativo a la raiz del proyecto, no al CWD.
# CARE_FEEDBACK_JSONL=feedback.jsonl

# --- Ingesta de Gmail -------------------------------------------------------
# GMAIL_CREDENTIALS=credentials.json   # secreto OAuth de Google Cloud
# GMAIL_TOKEN=token.json               # lo genera `--autorizar`
# GMAIL_USER=me                        # o una direccion si hay delegacion
# Query ACOTADA a proposito. 'in:inbox is:unread' procesaria correos personales
# cualesquiera contra el modelo real y los marcaria como leidos. Con este marcador
# en el asunto, tu decides exactamente que entra.
GMAIL_QUERY=subject:CARE-TEST
GMAIL_MAX=5
GMAIL_LABEL=CareAI/Procesado

# Tu direccion de Gmail, para que el CRM simulado la reconozca como contacto de
# UFPSO. Sin esto todo caso sale NO IDENTIFICADA y no se ejercita ninguna
# validacion. Andamio de demo: se borra al conectar el CRM real.
CARE_CORREO_DEMO=
# Borrador de respuesta al cliente: al aprobar una accion de sistema CORREO,
# deja un BORRADOR en el hilo de Gmail. Nunca envia: lo manda el ejecutivo.
# Apagado por defecto porque escribe en el buzon. Usa el scope gmail.modify que
# ya tenemos, asi que no hace falta reautorizar.
CARE_BORRADOR_GMAIL=0

# GMAIL_SOLO_LECTURA=1                 # scope readonly, no marca nada en el buzon

# Consola del mini sistema legado: es otra app (`python -m src.sistemas_web`).
# La bandeja solo la enlaza desde el detalle del caso.
# CARE_SISTEMAS_URL=http://127.0.0.1:8002
